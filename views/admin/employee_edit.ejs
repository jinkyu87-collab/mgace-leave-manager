<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>직원 정보 수정 - MGACE 연차관리</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="navbar">
    <div class="brand">MGACE 연차관리 · 관리자</div>
    <nav>
      <a href="/admin">대시보드</a>
      <a href="/admin/employees" class="active">직원관리</a>
      <a href="/admin/requests">연차승인</a>
      <a href="/admin/promotion">연차촉진</a>
    </nav>
    <div class="user">
      <%= emp.display_name %>님
      <form method="POST" action="/logout"><button class="btn-outline btn-sm" type="submit">로그아웃</button></form>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <h2><%= employee.display_name %> 정보 수정</h2>
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

      <form method="POST" action="/admin/employees/<%= employee.id %>/edit">
        <div class="row">
          <div class="field">
            <label>이름</label>
            <input type="text" name="name" value="<%= employee.name %>" required>
          </div>
          <div class="field">
            <label>생년월일 (8자리, 로그인용)</label>
            <input type="text" name="birth_date" value="<%= employee.birth_date %>" maxlength="8" required>
          </div>
        </div>
        <div class="row">
          <div class="field">
            <label>입사일</label>
            <input type="date" name="hire_date" value="<%= employee.hire_date %>" required>
          </div>
          <div class="field">
            <label>부서</label>
            <input type="text" name="department" value="<%= employee.department || '' %>">
          </div>
          <div class="field">
            <label>권한</label>
            <select name="role">
              <option value="employee" <%= employee.role === 'employee' ? 'selected' : '' %>>직원</option>
              <option value="admin" <%= employee.role === 'admin' ? 'selected' : '' %>>관리자</option>
            </select>
          </div>
        </div>
        <button type="submit">저장</button>
        <a href="/admin/employees" class="btn btn-outline">취소</a>
      </form>
    </div>
  </div>
</body>
</html>
