<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>내 연차 - MGACE 연차관리</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="navbar">
    <div class="brand">MGACE 연차관리</div>
    <div class="user">
      <%= emp.display_name %>님
      <form method="POST" action="/logout"><button class="btn-outline btn-sm" type="submit">로그아웃</button></form>
    </div>
  </div>

  <div class="container">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="card">
      <h2>연차 현황 (<%= balance.yearStart %> ~ <%= balance.yearEnd %>)</h2>
      <div class="grid">
        <div class="stat"><div class="num"><%= balance.entitlement %></div><div class="label">발생 연차</div></div>
        <div class="stat"><div class="num"><%= balance.used %></div><div class="label">사용</div></div>
        <div class="stat"><div class="num"><%= balance.pending %></div><div class="label">승인 대기</div></div>
        <div class="stat"><div class="num" style="color:var(--success)"><%= balance.remaining %></div><div class="label">잔여</div></div>
      </div>
    </div>

    <div class="card">
      <h2>연차 신청</h2>
      <form method="POST" action="/request">
        <div class="field">
          <label>신청 종류</label>
          <select name="leave_type" id="leave_type" onchange="toggleLeaveFields()">
            <option value="full">연차 (1일 단위)</option>
            <option value="half">반차 (0.5일)</option>
            <option value="quarter">반반차 (0.25일)</option>
            <option value="hourly">시차 (시간 단위)</option>
          </select>
        </div>

        <div id="fields-full" class="leave-fields">
          <div class="row">
            <div class="field">
              <label>시작일</label>
              <input type="date" name="start_date">
            </div>
            <div class="field">
              <label>종료일</label>
              <input type="date" name="end_date">
            </div>
          </div>
        </div>

        <div id="fields-half" class="leave-fields" style="display:none;">
          <div class="row">
            <div class="field">
              <label>사용일</label>
              <input type="date" name="half_date">
            </div>
            <div class="field">
              <label>시간대</label>
              <select name="half_period">
                <option value="am">오전 반차</option>
                <option value="pm">오후 반차</option>
              </select>
            </div>
          </div>
        </div>

        <div id="fields-quarter" class="leave-fields" style="display:none;">
          <div class="row">
            <div class="field">
              <label>사용일</label>
              <input type="date" name="quarter_date">
            </div>
            <div class="field">
              <label>시간대</label>
              <select name="quarter_period">
                <option value="am1">오전 1반반차</option>
                <option value="am2">오전 2반반차</option>
                <option value="pm1">오후 1반반차</option>
                <option value="pm2">오후 2반반차</option>
              </select>
            </div>
          </div>
        </div>

        <div id="fields-hourly" class="leave-fields" style="display:none;">
          <div class="row">
            <div class="field">
              <label>사용일</label>
              <input type="date" name="hourly_date">
            </div>
            <div class="field">
              <label>시작 시각</label>
              <select name="hourly_start_hour">
                <option value="9">09:00</option>
                <option value="10">10:00</option>
                <option value="11">11:00</option>
                <option value="12">12:00</option>
                <option value="13">13:00</option>
                <option value="14">14:00</option>
                <option value="15">15:00</option>
                <option value="16">16:00</option>
                <option value="17">17:00</option>
              </select>
            </div>
            <div class="field">
              <label>사용 시간</label>
              <select name="hourly_hours">
                <option value="1">1시간</option>
                <option value="2">2시간</option>
                <option value="3">3시간</option>
                <option value="4">4시간</option>
                <option value="5">5시간</option>
                <option value="6">6시간</option>
                <option value="7">7시간</option>
              </select>
            </div>
          </div>
          <p class="muted">1시간 단위로만 신청 가능하며, 1일 = 8시간 기준으로 자동 환산됩니다.</p>
        </div>

        <div class="field">
          <label>사유 (선택)</label>
          <textarea name="reason" rows="2" placeholder="예: 개인 사정"></textarea>
        </div>
        <button type="submit">신청하기</button>
      </form>
    </div>

    <script>
      function toggleLeaveFields() {
        const type = document.getElementById('leave_type').value;
        ['full', 'half', 'quarter', 'hourly'].forEach(t => {
          document.getElementById('fields-' + t).style.display = (t === type) ? 'block' : 'none';
        });
      }
    </script>

    <div class="card">
      <h2>신청 내역</h2>
      <table>
        <thead>
          <tr><th>종류</th><th>기간</th><th>일수</th><th>사유</th><th>상태</th><th></th></tr>
        </thead>
        <tbody>
          <% const typeLabels = { full: '연차', half: '반차', quarter: '반반차', hourly: '시차' }; %>
          <% requests.forEach(r => { %>
          <tr>
            <td><%= typeLabels[r.leave_type] || '연차' %><% if (r.detail) { %><br><span class="muted"><%= r.detail %></span><% } %></td>
            <td><%= r.start_date === r.end_date ? r.start_date : r.start_date + ' ~ ' + r.end_date %></td>
            <td><%= r.days %>일</td>
            <td><%= r.reason || '-' %></td>
            <td><span class="badge badge-<%= r.status %>">
              <%= { pending: '대기중', approved: '승인', rejected: '반려', cancelled: '취소됨' }[r.status] %>
            </span></td>
            <td>
              <% if (r.status === 'pending') { %>
              <form method="POST" action="/request/<%= r.id %>/cancel" class="inline">
                <button type="submit" class="btn-sm btn-danger">취소</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (requests.length === 0) { %>
          <tr><td colspan="6" class="muted">신청 내역이 없습니다.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
